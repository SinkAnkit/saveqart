PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
DB_PATH=./saveqart.db
OPEN_FOOD_FACTS_BASE=https://world.openfoodfacts.org
OPEN_PRICES_BASE=https://prices.openfoodfacts.org
NOMINATIM_BASE=https://nominatim.openstreetmap.org

# --- Location provider ---
# When GOOGLE_MAPS_API_KEY is set, precise Google Places (New) autocomplete +
# Geocoding is used for location search/reverse. When empty, the app falls back
# to free OpenStreetMap Nominatim automatically. Enable these APIs on your key:
#   Places API (New), Geocoding API  (billing must be enabled on the GCP project)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=in
GOOGLE_MAPS_LANGUAGE=en

SWIGGY_INSTAMART_ENDPOINT=
SWIGGY_INSTAMART_API_KEY=
SWIGGY_INSTAMART_STORE_ID=

# --- Email (Nodemailer) ---
# When SMTP_HOST is set, emails are sent. Otherwise they are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SaveQart <noreply@saveqart.local>
FRONTEND_URL=http://localhost:5173
